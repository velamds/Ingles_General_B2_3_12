ontents": [{"type": "text", "content": " \nI'm fairly certain ...\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "text", "content": "Instructions: \n<span class=\"bullet\">Proofread the sentence.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span>"}], "type": "post_instructions"}], "id": 9}, {"questions": [{"_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}], "id": 0, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "RSLT", "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}], "id": 10}, {"questions": [{"_data": [{"contents": [{"type": "pdf", "content": "engenn11le12ob02re7pdf01.pdf"}], "type": "question"}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "_data": [{"contents": [{"type": "text", "content": " Plan and budget a class trip."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}], "type": "post_instructions"}], "id": 11}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"images": [{"time": "0", "text": "", "id": 0, "image": "engenn11le12ob02re2img05.jpg"}, {"time": "100", "text": "<span class=\"strong\">Adam</span>: I'm getting a bit anxious. Weren't we supposed to have heard about the conference by now? It would be disappointing to have written that whole proposal only to have the request denied.\n<br>\n<span class=\"strong\">Boris</span>: We did hear back! Kristi was supposed to have told you. It was all approved!<br><span class=\"strong\">Adam</span>: Amazing! If you have some time this afternoon, will you please send me a copy of the confirmation? <br><span class=\"strong\">Boris</span>: I will send it to you when I get back to the office. I do have a copy right here on my tablet, though. Would you like to look it over?<br><span class=\"strong\">Adam</span>: Sure, let's give it a once-over, just to make sure everything is in order. Were all of our requisitions accepted?\n<br>\n<span class=\"strong\">Boris</span>: More or less. We were smart to have submitted such a detailed proposal. They really went over it with a fine-tooth comb. <br><span class=\"strong\">Adam</span>: Did we get our per diem?<br>\n<span class=\"strong\">Boris</span>: They reduced it slightly, but all meals and cabs will be covered. If we provide   itemized receipts, all other expenses will be covered as well.<br>", "id": 1, "image": "engenn11le12ob02re2img05.jpg"}, {"time": "54000", "text": "<span class=\"strong\">Adam</span>: What about tips? If we tip a cab driver, we won't really be able to get a receipt.<br><span class=\"strong\">Boris</span>: That's why there's an extra amount in the per diem. <br><span class=\"strong\">Adam</span>: How about the flight and the hotel?<br><span class=\"strong\">Boris</span>: Approved and approved!<br><span class=\"strong\">Adam</span>: Perfect, and I suppose we will receive our conference badges when we check in, right?<br><span class=\"strong\">Boris</span>: Actually, they will be sent here, to the office.<br><span class=\"strong\">Adam</span>: Wow, this is really great. You just made my day!\n<br>\n<span class=\"strong\">Boris</span>: I'm glad to have made your day, Adam, but I've got to ask, why are you so excited about all of this?<br>", "id": 2, "image": "engenn11le12ob02re2img06.jpg"}, {"time": "88000", "text": "<span class=\"strong\">Adam</span>: I guess I'm just shocked to have received everything we asked for. We could have asked for even more!<br><span class=\"strong\">Boris</span>: I suppose, but they are giving us a great deal of autonomy. I certainly wouldn't want to betray their trust.\n<br>\n<span class=\"strong\">Adam</span>: No, of course not. I was just thinking out loud. Well, I guess we'll have plenty of time to discuss the details on our flight to Chicago. Have a great afternoon, Boris.", "id": 3, "image": "engenn11le12ob02re2img07.jpg"}], "audiosrc": "engenn11le12ob02re2aud01", "coverimg": "engenn11le12ob02re2img05.jpg"}}], "template_override": 1, "type": "audio", "id": 1, "_data": [], "title": ""}], "id": 0}]}