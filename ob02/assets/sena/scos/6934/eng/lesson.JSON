ns", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn11le12ob02re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Plan and budget a class trip.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn11le12ob02re2aud01", "coverimg": "engenn11le12ob02re2img05.jpg", "images": [{"image": "engenn11le12ob02re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn11le12ob02re2img05.jpg", "text": "<span class=\"strong\">Adam</span>: I'm getting a bit anxious. Weren't we supposed to have heard about the conference by now? It would be disappointing to have written that whole proposal only to have the request denied.\n<br>\n<span class=\"strong\">Boris</span>: We did hear back! Kristi was supposed to have told you. It was all approved!<br><span class=\"strong\">Adam</span>: Amazing! If you have some time this afternoon, will you please send me a copy of the confirmation? <br><span class=\"strong\">Boris</span>: I will send it to you when I get back to the office. I do have a copy right here on my tablet, though. Would you like to look it over?<br><span class=\"strong\">Adam</span>: Sure, let's give it a once-over, just to make sure everything is in order. Were all of our requisitions accepted?\n<br>\n<span class=\"strong\">Boris</span>: More or less. We were smart to have submitted such a detailed proposal. They really went over it with a fine-tooth comb. <br><span class=\"strong\">Adam</span>: Did we get our per diem?<br>\n<span class=\"strong\">Boris</span>: They reduced it slightly, but all meals and cabs will be covered. If we provide   itemized receipts, all other expenses will be covered as well.<br>", "time": "100", "id": 1}, {"image": "engenn11le12ob02re2img06.jpg", "text": "<span class=\"strong\">Adam</span>: What about tips? If we tip a cab driver, we won't really be able to get a receipt.<br><span class=\"strong\">Boris</span>: That's why there's an extra amount in the per diem. <br><span class=\"strong\">Adam</span>: How about the flight and the hotel?<br><span class=\"strong\">Boris</span>: Approved and approved!<br><span class=\"strong\">Adam</span>: Perfect, and I suppose we will receive our conference badges when we check in, right?<br><span class=\"strong\">Boris</span>: Actually, they will be sent here, to the office.<br><span class=\"strong\">Adam</span>: Wow, this is really great. You just made my day!\n<br>\n<span class=\"strong\">Boris</span>: I'm glad to have made your day, Adam, but I've got to ask, why are you so excited about all of this?<br>", "time": "54000", "id": 2}, {"image": "engenn11le12ob02re2img07.jpg", "text": "<span class=\"strong\">Adam</span>: I guess I'm just shocked to have received everything we asked for. We could have asked for even more!<br><span class=\"strong\">Boris</span>: I suppose, but they are giving us a great deal of autonomy. I certainly wouldn't want to betray their trust.\n<br>\n<span class=\"strong\">Adam</span>: No, of course not. I was just thinking out loud. Well, I guess we'll have plenty of time to discuss the details on our flight to Chicago. Have a great afternoon, Boris.", "time": "88000", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}